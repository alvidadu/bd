<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_flat"
    android:padding="14dp" android:layout_margin="6dp" android:gravity="center_vertical">
    <TextView android:id="@+id/status" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center"
        android:textSize="15sp" android:textStyle="bold" />
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
        <TextView android:id="@+id/name" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/detail" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginTop="2dp"
            android:maxLines="1" android:ellipsize="middle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
