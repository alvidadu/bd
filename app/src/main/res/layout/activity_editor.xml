<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:paddingStart="6dp" android:paddingEnd="12dp"
        android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="center_vertical" android:elevation="4dp">
        <Button android:id="@+id/btnFiles" android:text="☰" style="@style/ButtonIcon"
            android:layout_width="42dp" android:layout_height="42dp" />
        <TextView android:id="@+id/projectName" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="15sp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="middle" />
        <Button android:id="@+id/btnSave" android:text="Save" style="@style/ButtonGhost"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" />
        <Button android:id="@+id/btnSettings" android:text="⚙" style="@style/ButtonIcon"
            android:layout_width="42dp" android:layout_height="42dp" />
        <Button android:id="@+id/btnBuild" android:text="▶ Build" style="@style/ButtonPrimary"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/divider" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

        <LinearLayout android:id="@+id/filePanel" android:layout_width="260dp" android:layout_height="match_parent"
            android:orientation="vertical" android:background="@color/bg_elevated" android:visibility="gone">
            <TextView android:text="PROJECT FILES" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"
                android:letterSpacing="0.06" android:padding="14dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ListView android:id="@+id/fileList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:divider="@null" android:dividerHeight="0dp" android:listSelector="@drawable/bg_row_ripple" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@drawable/divider" />

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:id="@+id/filePath" android:textColor="@color/text_secondary" android:textSize="12sp"
                android:background="@color/bg_elevated" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:singleLine="true" android:ellipsize="start"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ScrollView android:layout_width="wrap_content" android:layout_height="match_parent">
                    <EditText android:id="@+id/editor" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minWidth="800dp" android:gravity="top|start" android:background="@color/bg" android:textColor="@color/text_primary"
                        android:typeface="monospace" android:textSize="13sp" android:inputType="textMultiLine|textNoSuggestions"
                        android:cursorVisible="true" android:padding="14dp" />
                </ScrollView>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
