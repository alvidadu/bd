<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.aps.azebri">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.RECEIVE_SMS" />
	<uses-permission android:name="android.permission.READ_SMS" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<!-- অ্যান্ড্রয়েড ১৪ এর জন্য এই পারমিশনটি জরুরি -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

	<application
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:theme="@style/AppTheme">

		<activity android:name="com.aps.azebri.ShujonActivity" android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity android:name="com.aps.azebri.MainActivity" android:exported="false" />
		<activity android:name="com.aps.azebri.ViewActivity" android:exported="false" />

		<receiver android:name="com.aps.azebri.SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
			<intent-filter android:priority="999">
				<action android:name="android.provider.Telephony.SMS_RECEIVED" />
			</intent-filter>
		</receiver>

		<!-- এখানে foregroundServiceType যোগ করা হয়েছে -->
		<service
			android:name="com.aps.azebri.NotificationService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

	</application>
</manifest>