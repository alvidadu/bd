<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@drawable/ic_launcher"
        android:label="APK Builder"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".NewProjectActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EditorActivity" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".SettingsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ToolchainActivity" />
        <activity android:name=".BuildActivity" />

        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.apkbuilder.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Dependency-free custom provider (see ApkFileProvider.java) - no androidx.core needed -->
    </application>
</manifest>
